commit_msg=$(cat "$1")

# 허용 타입 목록
pattern="^(feat|fix|chore|docs|style|refactor|test|perf): .+ \(#[0-9]+\)$"

if ! echo "$commit_msg" | grep -qE "$pattern"; then
  echo ""
  echo "❌ 커밋 메시지 형식이 올바르지 않습니다."
  echo ""
  echo "  올바른 형식: <type>: 한글 한줄 요약 (#이슈번호)"
  echo "  예시: feat: 로그인 기능 추가 (#1)"
  echo ""
  echo "  허용 타입: feat | fix | chore | docs | style | refactor | test | perf"
  echo ""
  exit 1
fi
